---
import "../styles/global.css";
import { SITE_NAME, DISCLAIMER, CF_ANALYTICS_TOKEN, SITE_URL } from "../config.ts";

interface Props {
  title: string;
  description?: string;
  sample?: boolean;
}
const { title, description = "Enflasyon ve kurdan arındırılmış reel finans verisi.", sample = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = SITE_URL ? `${SITE_URL}${path === "/" ? "/" : `${path}/`}` : null;
const ogImage = SITE_URL ? `${SITE_URL}/og.png` : "/og.png";
const fullTitle = `${title} · ${SITE_NAME}`;
const groups = [
  { label: "Piyasalar", items: [
    { href: "/", label: "Reel Tablo" },
    { href: "/grafik", label: "Grafik: X'in Y cinsinden fiyatı" },
    { href: "/borsa", label: "Borsa" },
  ] },
  { label: "Makro", items: [
    { href: "/turkiye", label: "Türkiye profili" },
    { href: "/makro", label: "Makro Pano" },
    { href: "/iliskiler", label: "İlişkiler" },
    { href: "/reel-faiz", label: "Reel Faiz" },
    { href: "/olaylar", label: "Olay penceresi" },
    { href: "/ulkeler", label: "Ülke karşılaştırması" },
    { href: "/iller", label: "İller: ekonomik harita" },
  ] },
  { label: "Borç", items: [
    { href: "/kredi", label: "Kredinin gerçek maliyeti" },
    { href: "/kart", label: "Kredi kartı: asgari ödeme, nakit avans" },
    { href: "/yapilandirma", label: "Kredi yapılandırma" },
    { href: "/taksit", label: "Taksitli mi, peşin mi?" },
  ] },
  { label: "Hesapla", items: [
    { href: "/portfoy", label: "Portföyüm" },
    { href: "/mevduat", label: "Mevduat: net ve reel getiri" },
    { href: "/birikim", label: "Birikim hedefi" },
    { href: "/maas", label: "Reel maaş takibi" },
    { href: "/konut", label: "Konut: kirala mı, satın al mı?" },
    { href: "/nominal-illuzyon", label: "Nominal illüzyon ve erime hızı" },
    { href: "/kisisel-enflasyon", label: "Kişisel enflasyon" },
  ] },
];
const inGroup = (g: (typeof groups)[number]) => g.items.some((i) => i.href === path);
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#111214" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (_) {}
    </script>
  </head>
  <body>
    {sample && <div class="warn-band" role="alert">ÖRNEK VERİ — gerçek değildir</div>}
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{SITE_NAME}</a>
        <button class="menu-toggle" type="button" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menü</button>
        <nav class="site-nav" id="site-nav" aria-label="Ana menü">
          {groups.map((g) => (
            <details class="dd">
              <summary class={inGroup(g) ? "current" : undefined}>{g.label}</summary>
              <ul class="dd-menu">
                {g.items.map((i) => <li><a href={i.href} aria-current={path === i.href ? "page" : undefined}>{i.label}</a></li>)}
              </ul>
            </details>
          ))}
          <a class="top-link" href="/metodoloji" aria-current={path === "/metodoloji" ? "page" : undefined}>Metodoloji</a>
          <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Temayı değiştir">Tema</button>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{DISCLAIMER}</strong> Bu site hesaplar, karşılaştırır ve varsayımlarını gösterir; karar sizindir.</p>
        <p>Hesaplayıcılar tarayıcınızda çalışır; girdiğiniz hiçbir bilgi bir sunucuya gönderilmez.</p>
        <nav class="foot-nav" aria-label="Alt menü">
          <a href="/metodoloji">Metodoloji</a>
          <a href="/veri">Veri durumu</a>
          <a href="/mevzuat">Mevzuat takibi</a>
          <a href="/bulten">Bülten</a>
          <a href="/yasal-uyari">Yasal uyarı</a>
          <a href="/gizlilik">Gizlilik ve KVKK</a>
        </nav>
      </div>
    </footer>
    <noscript><style>.site-nav { display: flex !important; } .menu-toggle { display: none !important; }</style></noscript>
    <script is:inline>
      (function () {
        const menu = document.getElementById("menu-toggle");
        const nav = document.getElementById("site-nav");
        const dds = [...nav.querySelectorAll("details.dd")];
        const mobile = matchMedia("(max-width: 1023px)");
        const sync = () => dds.forEach((d) => (d.open = mobile.matches));   // mobile panel: all groups open
        sync();
        mobile.addEventListener("change", sync);
        menu.addEventListener("click", () => {
          const open = menu.getAttribute("aria-expanded") !== "true";
          menu.setAttribute("aria-expanded", String(open));
          nav.classList.toggle("open", open);
        });
        // Desktop: one dropdown at a time; close on outside click or Escape.
        dds.forEach((d) => d.addEventListener("toggle", () => {
          if (d.open && !mobile.matches) dds.forEach((o) => o !== d && (o.open = false));
        }));
        document.addEventListener("click", (ev) => {
          if (!mobile.matches && !nav.contains(ev.target)) dds.forEach((d) => (d.open = false));
        });
        document.addEventListener("keydown", (ev) => {
          if (ev.key === "Escape" && !mobile.matches) dds.forEach((d) => (d.open = false));
        });
      })();
      (function () {
        const btn = document.getElementById("theme-toggle");
        const root = document.documentElement;
        const current = () =>
          root.dataset.theme ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const label = () => { btn.textContent = current() === "dark" ? "Açık tema" : "Koyu tema"; };
        label();
        btn.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch (_) {}
          label();
        });
      })();
    </script>
    {CF_ANALYTICS_TOKEN && (
      <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}></script>
    )}
  </body>
</html>
