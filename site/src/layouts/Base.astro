---
import "../styles/global.css";
import { SITE_NAME, DISCLAIMER, CF_ANALYTICS_TOKEN, SITE_URL } from "../config.ts";

interface Props {
  title: string;
  description?: string;
  sample?: boolean;
}
const { title, description = "Enflasyon ve kurdan arındırılmış reel finans verisi.", sample = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = SITE_URL ? `${SITE_URL}${path === "/" ? "/" : `${path}/`}` : null;
const ogImage = SITE_URL ? `${SITE_URL}/og.png` : "/og.png";
const fullTitle = `${title} · ${SITE_NAME}`;
const nav = [
  { href: "/", label: "Reel Tablo" },
  { href: "/nominal-illuzyon", label: "Nominal İllüzyon" },
  { href: "/kisisel-enflasyon", label: "Kişisel Enflasyon" },
  { href: "/reel-faiz", label: "Reel Faiz" },
  { href: "/metodoloji", label: "Metodoloji" },
];
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#111214" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (_) {}
    </script>
  </head>
  <body>
    {sample && <div class="warn-band" role="alert">ÖRNEK VERİ — gerçek değildir</div>}
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{SITE_NAME}</a>
        <nav class="site-nav" aria-label="Ana menü">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>
          ))}
          <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Temayı değiştir">Tema</button>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{DISCLAIMER}</strong> Bu site hesaplar, karşılaştırır ve varsayımlarını gösterir; karar sizindir.</p>
        <p>Hesaplayıcılar tarayıcınızda çalışır; girdiğiniz hiçbir bilgi bir sunucuya gönderilmez.</p>
        <nav class="foot-nav" aria-label="Alt menü">
          <a href="/metodoloji">Metodoloji</a>
          <a href="/veri">Veri durumu</a>
          <a href="/bulten">Bülten</a>
          <a href="/yasal-uyari">Yasal uyarı</a>
          <a href="/gizlilik">Gizlilik ve KVKK</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (function () {
        const btn = document.getElementById("theme-toggle");
        const root = document.documentElement;
        const current = () =>
          root.dataset.theme ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const label = () => { btn.textContent = current() === "dark" ? "Açık tema" : "Koyu tema"; };
        label();
        btn.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch (_) {}
          label();
        });
      })();
    </script>
    {CF_ANALYTICS_TOKEN && (
      <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}></script>
    )}
  </body>
</html>
