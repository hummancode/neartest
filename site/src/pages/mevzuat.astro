---
import Base from "../layouts/Base.astro";
import { mevzuat, STATUS_LABEL, formatTariff, type Tariff } from "../lib/params.ts";
const groups = [...new Set(mevzuat.params.map((p) => p.group))];
const show = (v: number | Tariff, unit: string) => (unit === "tarife" ? fmt(v) : `${fmt(v)} ${unit}`);
const fmt = (v: number | Tariff) => (Array.isArray(v) ? formatTariff(v) : new Intl.NumberFormat("tr-TR", { maximumFractionDigits: 2 }).format(v));
const unverified = mevzuat.params.filter((p) => p.current?.status !== "verified").length;
---
<Base title="Mevzuat takibi" description="Hesaplayıcılarda kullanılan düzenlenmiş oranlar: KKDF, BSMV, stopaj, kredi kartı azami faizleri; kaynak, yürürlük ve kontrol tarihiyle.">
  <h1>Mevzuat takibi</h1>
  <p class="lead">
    Kredi ve mevduat hesaplarında kullanılan oranlar mevzuatla belirlenir ve değişir. Burada her oranın güncel değeri,
    yürürlük tarihi, resmî kaynağı ve en son ne zaman kontrol edildiği yer alır. Hesaplayıcılar varsayılan değerlerini buradan alır.
  </p>
  {unverified > 0 && (
    <p class="callout card"><strong>{unverified} oran henüz resmî metinden doğrulanmadı.</strong> Bu değerler ikincil kaynaklardan derlenmiştir;
      kullanmadan önce ödeme planınızdaki veya bankanızdaki güncel oranı kontrol edin.</p>
  )}
  {groups.map((g) => (
    <section>
      <h2>{g}</h2>
      <div class="card scroll-x">
        <table class="data params">
          <thead><tr><th scope="col">Oran</th><th scope="col">Değer</th><th scope="col">Durum</th><th scope="col">Yürürlük</th><th scope="col">Son kontrol</th><th scope="col">Kaynak</th></tr></thead>
          <tbody>
            {mevzuat.params.filter((p) => p.group === g).map((p) => (
              <>
                <tr id={p.id}>
                  <th scope="row">{p.label}</th>
                  <td class="val">{p.current ? show(p.current.value, p.unit) : "—"}</td>
                  <td><span class={`badge ${p.current?.status}`}>{p.current ? STATUS_LABEL[p.current.status] : "—"}</span>{p.stale && <span class="badge stale">kontrol zamanı</span>}</td>
                  <td>{p.current?.effective_from ?? "belirtilmedi"}</td>
                  <td>{p.last_checked ?? "—"}</td>
                  <td>{p.current?.source.url ? <a href={p.current.source.url} rel="noopener" target="_blank">{p.current.source.title || "bağlantı"}</a> : "—"}</td>
                </tr>
                {(p.current?.note || p.history.length > 1 || p.upcoming) && (
                  <tr class="detail"><td colspan="6">
                    {p.current?.note && <p class="small">{p.current.note}</p>}
                    {p.upcoming && <p class="small"><strong>Yaklaşan değişiklik:</strong> {show(p.upcoming.value, p.unit)}, {p.upcoming.effective_from} itibarıyla.</p>}
                    {p.history.length > 1 && (
                      <details><summary class="small">Geçmiş ({p.history.length})</summary>
                        <ul class="small">{p.history.map((h) => <li>{h.effective_from ?? "tarih belirtilmedi"}: {show(h.value, p.unit)} — {STATUS_LABEL[h.status]}{h.source.title ? ` · ${h.source.title}` : ""}</li>)}</ul>
                      </details>
                    )}
                  </td></tr>
                )}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
  <h2>Nasıl güncellenir?</h2>
  <ol>
    <li>Resmî kaynak (Resmî Gazete, TCMB, GİB, BDDK) okunur.</li>
    <li><code>data/params/parametreler.json</code> dosyasında ilgili oranın geçmişine yeni bir kayıt eklenir: değer, yürürlük tarihi, kaynak bağlantısı, kontrol eden, tarih ve <code>status: "verified"</code>. Eski kayıtlar silinmez.</li>
    <li>Derleme kaydı doğrular; resmî kaynağı olmayan bir kayıt “doğrulandı” olarak işaretlenemez.</li>
    <li>Her hafta otomatik bir kontrol, süresi geçen veya doğrulanmamış oranları bir GitHub issue'sunda listeler. Sistem oranları kendiliğinden değiştirmez.</li>
  </ol>
  <p class="muted small">Sayfa tarihi: {mevzuat.as_of}. Bu sayfa hukuki görüş değildir; bağlayıcı olan resmî metindir.</p>
</Base>
<style is:global>
  .params { min-width: 760px; font-size: 0.88rem; }
  .params th, .params td { text-align: left; vertical-align: top; }
  .params tbody th { font-weight: 600; }
  .params td.val { font-weight: 700; white-space: nowrap; }
  .params tr.detail td { border-top: 0; padding-top: 0; color: var(--ink-2); }
  .params tr.detail p { margin: 2px 0; }
  .badge { display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 1px 7px; border-radius: 999px; border: 1px solid currentColor; margin-right: 4px; white-space: nowrap; }
  .badge.verified { color: var(--ink); }
  .badge.candidate, .badge.stale { color: var(--warn-bg); }
  .badge.example { color: var(--muted); }
  .scroll-x { overflow-x: auto; padding: 4px 8px; }
</style>
