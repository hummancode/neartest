---
import Base from "../layouts/Base.astro";
import { housing } from "../lib/housing.ts";
import { DISCLAIMER } from "../config.ts";
const ref = housing.reference;
const payload = { cpi_12m: ref.cpi_12m, sample: ref.sample };
---
<Base title="Kredi kartı: asgari ödeme ve nakit avans" description="Kredi kartında yalnızca asgari ödeme yaparsanız borç kaç ayda biter, kaç TL faiz ödersiniz? Nakit avansın gerçek yıllık maliyeti." sample={ref.sample}>
  <h1>Kredi kartı</h1>
  <p class="lead">“Asgari ödemeyi yap, gerisi sonra” tatlı gelir; ama kalan borca her ay faiz ve vergi eklenir. Nakit avansta da ücret ve faiz bir araya gelir.</p>

  <h2>Yalnızca asgari ödeme yaparsam?</h2>
  <form id="fm" class="card" novalidate onsubmit="return false">
    <div class="form-grid three">
      <div class="field"><label for="bal">Kart borcu (TL)</label><input id="bal" inputmode="decimal" value="50.000" /></div>
      <div class="field"><label for="crate">Aylık akdi faiz (%)</label><input id="crate" inputmode="decimal" value="4,25" /><small>ekstrenizdeki aylık akdi faiz — örnek değer</small></div>
      <div class="field"><label for="minshare">Asgari ödeme oranı (%)</label><input id="minshare" inputmode="decimal" value="20" /><small>kart limitine göre değişir — ekstrenizdeki oranı girin</small></div>
      <div class="field"><label for="minfloor">En az ödeme (TL)</label><input id="minfloor" inputmode="decimal" value="0" /><small>bankanın alt sınırı varsa</small></div>
      <div class="field"><label for="ckkdf">KKDF (faizin %'si)</label><input id="ckkdf" inputmode="decimal" value="15" /><small>örnek — güncel oranı kontrol edin</small></div>
      <div class="field"><label for="cbsmv">BSMV (faizin %'si)</label><input id="cbsmv" inputmode="decimal" value="15" /><small>örnek — güncel oranı kontrol edin</small></div>
    </div>
  </form>
  <p id="err-m" class="error" role="alert" hidden></p>
  <section class="stat-grid" aria-live="polite">
    <div class="card stat"><p class="s-label">Borç kaç ayda biter?</p><p class="s-value" id="m-months">—</p><p class="muted small" id="m-months-sub"></p></div>
    <div class="card stat"><p class="s-label">Toplam faiz + vergi</p><p class="s-value" id="m-cost">—</p><p class="muted small" id="m-cost-sub"></p></div>
    <div class="card stat"><p class="s-label">Toplam ödeme</p><p class="s-value" id="m-total">—</p><p class="muted small" id="m-total-sub"></p></div>
  </section>
  <section class="card"><h3 class="c-title">Kalan borç</h3><div id="m-chart" class="chart-box"></div></section>

  <h2>Nakit avansın gerçek maliyeti</h2>
  <form id="fa" class="card" novalidate onsubmit="return false">
    <div class="form-grid three">
      <div class="field"><label for="amt">Çekilen tutar (TL)</label><input id="amt" inputmode="decimal" value="20.000" /></div>
      <div class="field"><label for="arate">Aylık nakit avans faizi (%)</label><input id="arate" inputmode="decimal" value="4,25" /><small>örnek</small></div>
      <div class="field"><label for="amonths">Taksit sayısı</label><input id="amonths" inputmode="numeric" value="6" /><small>1 = tek çekim, ekstrede ödeme</small></div>
      <div class="field"><label for="afee">Nakit avans ücreti (TL)</label><input id="afee" inputmode="decimal" value="300" /><small>işlem başına ücret — ekstrenizdeki tutar (örnek)</small></div>
      <div class="field"><label for="akkdf">KKDF (%)</label><input id="akkdf" inputmode="decimal" value="15" /></div>
      <div class="field"><label for="absmv">BSMV (%)</label><input id="absmv" inputmode="decimal" value="15" /></div>
    </div>
  </form>
  <p id="err-a" class="error" role="alert" hidden></p>
  <section class="stat-grid" aria-live="polite">
    <div class="card stat"><p class="s-label">Gerçek yıllık maliyet</p><p class="s-value" id="a-apr">—</p><p class="muted small">ücret, faiz ve vergilerle (iç verim oranı)</p></div>
    <div class="card stat"><p class="s-label">Aylık taksit</p><p class="s-value" id="a-inst">—</p><p class="muted small" id="a-inst-sub"></p></div>
    <div class="card stat"><p class="s-label">Reel yıllık maliyet</p><p class="s-value" id="a-real">—</p><p class="muted small" id="a-real-sub"></p></div>
  </section>

  <h2>Varsayımlar</h2>
  <ul class="small">
    <li>Asgari ödeme senaryosunda karta yeni harcama yapılmadığı ve her ay tam asgari tutarın ödendiği varsayılır. Bankalar faizi günlük hesaplar; burada aylık adım kullanılır, sonuç yaklaşıktır.</li>
    <li>Gecikme faizi (asgari ödeme yapılmazsa) dahil değildir. Faiz oranları, asgari ödeme oranı, KKDF ve BSMV bankaya ve mevzuata göre değişir; bağlayıcı olan ekstrenizdir.</li>
    <li>Nakit avans, ücretin baştan kesildiği eşit taksitli bir kredi gibi hesaplanır. Formüller: <a href="/metodoloji#kart">Metodoloji</a>.</li>
  </ul>
  <p><strong>{DISCLAIMER}</strong></p>
  <script type="application/json" id="c-data" set:html={JSON.stringify(payload)}></script>
</Base>

<script>
  import { cardMinimumPayoff, loanCost, SeriesError } from "../lib/engine.ts";
  import { renderChart } from "../lib/chart.ts";
  import { readNumber, tl, tl2, pct } from "../lib/inputs.ts";
  import { readHash, writeHash } from "../lib/share.ts";

  const ref = JSON.parse(document.getElementById("c-data")!.textContent!);
  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const M = ["bal", "crate", "minshare", "minfloor", "ckkdf", "cbsmv"], A = ["amt", "arate", "amonths", "afee", "akkdf", "absmv"];
  const MONEY = new Set(["bal", "minfloor", "amt", "afee"]);
  const val = (id: string) => readNumber($(id), MONEY.has(id));

  function minimum() {
    const err = $<HTMLElement>("err-m");
    const v = Object.fromEntries(M.map((f) => [f, val(f)])) as Record<string, number | null>;
    if (M.some((f) => v[f] === null)) { err.textContent = "Tüm alanları doldurun."; err.hidden = false; return; }
    if (!(v.minshare! > 0 && v.minshare! <= 100)) { err.textContent = "Asgari ödeme oranı %0 ile %100 arasında olmalı."; err.hidden = false; return; }
    let r, full;
    try {
      const p = { balance: v.bal!, monthly_rate: v.crate! / 100, kkdf: v.ckkdf! / 100, bsmv: v.cbsmv! / 100, min_floor: v.minfloor! };
      r = cardMinimumPayoff({ ...p, min_share: v.minshare! / 100 });
      full = cardMinimumPayoff({ ...p, min_share: 1, min_floor: 0 });
    } catch (e) { if (e instanceof SeriesError) { err.textContent = "Bu değerlerle hesap yapılamadı."; err.hidden = false; return; } throw e; }
    err.hidden = true;
    const years = r.months / 12;
    $("m-months").textContent = r.paid_off ? `${r.months} ay` : "Bitmiyor";
    $("m-months-sub").textContent = r.paid_off ? `yaklaşık ${new Intl.NumberFormat("tr-TR", { maximumFractionDigits: 1 }).format(years)} yıl`
      : `asgari ödeme faizi karşılamıyor; borç her ay büyür — 1 yıl sonra ${tl(r.balances[12])}, 5 yıl sonra ${tl(r.balances[60])}`;
    // If the minimum never clears the debt, report the first 5 years instead of a 50-year total.
    const shownR = r.paid_off ? r : cardMinimumPayoff({ balance: v.bal!, monthly_rate: v.crate! / 100, kkdf: v.ckkdf! / 100, bsmv: v.cbsmv! / 100,
      min_floor: v.minfloor!, min_share: v.minshare! / 100, max_months: 60 });
    const span = r.paid_off ? "" : " (ilk 5 yıl)";
    $("m-cost").textContent = tl(shownR.total_interest + shownR.total_tax);
    $("m-cost-sub").textContent = `faiz ${tl(shownR.total_interest)} + vergi ${tl(shownR.total_tax)}${span} · tamamını ilk ay ödeseydiniz ${tl(full.total_interest + full.total_tax)}`;
    $("m-total").textContent = tl(shownR.total_paid);
    $("m-total-sub").textContent = r.paid_off ? `${tl(v.bal!)} borç için` : `ilk 5 yılda ödenen; borç hâlâ ${tl(shownR.remaining)}`;
    const shown = r.paid_off ? r.balances : r.balances.slice(0, 61);   // unbounded growth: show 5 years
    const months = shown.map((_, k) => { const d = new Date(2000, k, 1); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`; });
    renderChart($("m-chart"), { months, series: [{ key: "b", label: "Kalan borç", color: "var(--series-2)", values: shown }] },
      { baseline: null, format: tl, allowLog: false, xLabels: shown.map((_, k) => `${k}. ay`), tickEvery: Math.max(1, Math.ceil(shown.length / 8)) });
  }

  function advance() {
    const err = $<HTMLElement>("err-a");
    const v = Object.fromEntries(A.map((f) => [f, val(f)])) as Record<string, number | null>;
    if (A.some((f) => v[f] === null)) { err.textContent = "Tüm alanları doldurun."; err.hidden = false; return; }
    if (!Number.isInteger(v.amonths!) || v.amonths! < 1 || v.amonths! > 36) { err.textContent = "Taksit sayısı 1–36 arasında olmalı."; err.hidden = false; return; }
    if (v.afee! >= v.amt!) { err.textContent = "Ücret çekilen tutardan küçük olmalı."; err.hidden = false; return; }
    let r;
    try {
      r = loanCost({ principal: v.amt!, monthly_rate: v.arate! / 100, months: v.amonths!, kkdf: v.akkdf! / 100, bsmv: v.absmv! / 100,
        upfront_fees: v.afee!, monthly_fees: 0, inflation: ref.cpi_12m ?? 0 });
    } catch (e) { if (e instanceof SeriesError) { err.textContent = "Bu değerlerle hesap yapılamadı."; err.hidden = false; return; } throw e; }
    err.hidden = true;
    $("a-apr").textContent = pct(r.annual_cost);
    $("a-inst").textContent = tl2(r.installment);
    $("a-inst-sub").textContent = `toplam ${tl(r.total_paid)} (ücret dahil) · ilan edilen faiz × 12 = ${pct(r.advertised_annual)}`;
    $("a-real").textContent = pct(r.real_annual_cost);
    $("a-real-sub").textContent = `son 12 ay TÜFE'ye göre${ref.sample ? " (örnek veri)" : ""}`;
  }

  function update() {
    writeHash(Object.fromEntries([...M, ...A].map((f) => [f, $(f).value])));
    minimum(); advance();
  }
  const h = readHash();
  [...M, ...A].forEach((f) => { if (h.get(f) !== null) $(f).value = h.get(f)!; $(f).addEventListener("input", update); });
  let lastW = 0;
  new ResizeObserver(() => { const w = $("m-chart").clientWidth; if (Math.abs(w - lastW) > 2) { lastW = w; minimum(); } }).observe($("m-chart"));
  update();
</script>

<style is:global>
  .c-title { font-size: 1.15rem; margin: 0 0 6px; }
  .chart-box { min-height: 240px; }
</style>
