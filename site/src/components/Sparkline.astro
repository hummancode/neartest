---
// Tiny trend line for one series. Shape only: no axis, the table carries the numbers.
interface Props {
  values: number[];
  label: string;       // accessible name
  width?: number;
  height?: number;
}
const { values, label, width = 132, height = 36 } = Astro.props;
const pad = 4;
let d = "";
let last: [number, number] | null = null;
if (values.length >= 2) {
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min;
  // Treat float noise on a flat series as flat, instead of magnifying it into a zigzag.
  const flat = span <= 1e-9 * Math.max(Math.abs(max), Math.abs(min), 1);
  const pts = values.map((v, i) => {
    const x = pad + (i / (values.length - 1)) * (width - 2 * pad);
    const y = flat ? height / 2 : pad + (1 - (v - min) / span) * (height - 2 * pad);
    return [x, y] as [number, number];
  });
  d = pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join(" ");
  last = pts[pts.length - 1];
}
---
{values.length >= 2 ? (
  <svg class="spark" width={width} height={height} viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label}>
    <title>{label}</title>
    <path d={d} fill="none" stroke="var(--spark)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
    {last && <circle cx={last[0]} cy={last[1]} r="3" fill="var(--spark)" />}
  </svg>
) : (
  <span class="muted small">trend yok</span>
)}
