---
// Site-wide search: pages, 81 provinces, 973 districts, province indicators, assets.
// The index (/arama.json) is fetched only when the dialog first opens. Nothing leaves the browser.
---
<button class="search-btn" type="button" id="search-open" aria-haspopup="dialog" aria-label="Sitede ara">
  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
  <span class="search-label">Ara</span><kbd class="search-kbd">Ctrl K</kbd>
</button>
<dialog class="search-dlg" id="search-dlg" aria-label="Sitede ara">
  <div class="search-box">
    <input id="search-q" type="search" aria-label="Arama metni" placeholder="Sayfa, il, ilçe veya gösterge ara…" autocomplete="off" spellcheck="false"
      role="combobox" aria-expanded="true" aria-controls="search-res" aria-autocomplete="list" />
    <button type="button" class="search-close" id="search-close" aria-label="Kapat">Esc</button>
  </div>
  <ul id="search-res" class="search-res" role="listbox" aria-label="Sonuçlar"></ul>
  <p class="search-foot muted small" id="search-foot">↑↓ ile gezin, Enter ile açın.</p>
</dialog>
<script>
  import { searchIndex, type SearchEntry } from "../lib/search.ts";

  const dlg = document.getElementById("search-dlg") as HTMLDialogElement;
  const q = document.getElementById("search-q") as HTMLInputElement;
  const res = document.getElementById("search-res")!;
  const foot = document.getElementById("search-foot")!;
  let index: SearchEntry[] | null = null, loading: Promise<void> | null = null, results: SearchEntry[] = [], active = 0;
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
  document.querySelector(".search-kbd")!.textContent = isMac ? "⌘K" : "Ctrl K";

  function load() {
    loading ??= fetch("/arama.json").then((r) => r.json()).then((d) => { index = d; }).catch(() => { foot.textContent = "Arama dizini yüklenemedi."; });
    return loading;
  }
  function render() {
    res.replaceChildren(...results.map((r, i) => {
      const li = document.createElement("li");
      li.id = `sr-${i}`; li.setAttribute("role", "option"); li.setAttribute("aria-selected", String(i === active));
      const a = document.createElement("a"); a.href = r.u;
      const kind = document.createElement("span"); kind.className = "sr-kind"; kind.textContent = r.k;
      const t = document.createElement("span"); t.className = "sr-title"; t.textContent = r.t;
      const s = document.createElement("span"); s.className = "sr-sub muted small"; s.textContent = r.s ?? "";
      a.append(kind, t, s);
      a.addEventListener("click", () => dlg.close());
      li.appendChild(a);
      li.addEventListener("mousemove", () => { if (active !== i) { active = i; mark(); } });
      return li;
    }));
    q.setAttribute("aria-activedescendant", results.length ? `sr-${active}` : "");
    foot.textContent = q.value.trim() && !results.length ? "Sonuç yok. Başka bir yazım deneyin (ör. “kadikoy”, “enflasyon”)." : "↑↓ ile gezin, Enter ile açın.";
  }
  function mark() {
    res.querySelectorAll("li").forEach((li, i) => li.setAttribute("aria-selected", String(i === active)));
    q.setAttribute("aria-activedescendant", `sr-${active}`);
    res.querySelector(`#sr-${active}`)?.scrollIntoView({ block: "nearest" });
  }
  async function update() {
    await load();
    if (!index) return;
    results = searchIndex(index, q.value, 30);
    active = 0;
    render();
  }
  async function open() {
    if (!dlg.open) dlg.showModal();
    q.select();
    await update();
  }
  document.getElementById("search-open")!.addEventListener("click", open);
  document.getElementById("search-close")!.addEventListener("click", () => dlg.close());
  dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });   // backdrop
  q.addEventListener("input", update);
  q.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); if (results.length) { active = (active + 1) % results.length; mark(); } }
    else if (e.key === "ArrowUp") { e.preventDefault(); if (results.length) { active = (active - 1 + results.length) % results.length; mark(); } }
    else if (e.key === "Enter") { const r = results[active]; if (r) { e.preventDefault(); dlg.close(); location.href = r.u; } }
  });
  document.addEventListener("keydown", (e) => {
    const typing = e.target instanceof HTMLElement && (e.target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName));
    if ((e.key === "k" || e.key === "K") && (e.ctrlKey || e.metaKey)) { e.preventDefault(); open(); }
    else if (e.key === "/" && !typing && !dlg.open) { e.preventDefault(); open(); }
  });
  // Warm the index when the user shows intent.
  document.getElementById("search-open")!.addEventListener("pointerenter", () => { load(); }, { once: true });
</script>
